Package: liblrdf
Version: 0.6.1
Revision: 1
Source: https://github.com/swh/LRDF/archive/refs/tags/v%v.tar.gz
SourceRename: LRDF-%v.tar.gz
Source-Checksum: SHA256(d579417c477ac3635844cd1b94f273ee2529a8c3b6b21f9b09d15f462b89b1ef)
Maintainer: Adrian Prantl <adrian@f4z.org>
HomePage:  https://sourceforge.net/projects/lrdf/
License: LGPL
Description: Lightweight RDF library for LADSPA plugins
DocFiles: README COPYING
Depends: %N-shlibs (=%v-%r)
DescPackaging: <<
	Upstream hasn't responded to patch for migrating to libraptor2
	See: https://sourceforge.net/p/lrdf/patches/1/
<<
BuildDepends: <<
	autoconf2.6,
	automake1.15,
	fink-package-precedence,
	ladspa-dev,
	libraptor2-dev,
	libtool2,
	pkgconfig
<<
BuildDependsOnly: true
# debian 1002_rename_clashing_md5_symbols.patch
PatchFile: %n.patch
PatchFile-MD5: 40d1c7a2ae2b782bb8ef3f484bc1bf26
PatchScript: <<
	%{default_script}
	perl -pi -e 's/(-version-info)/-no-undefined \1/' src/Makefile.am
	mkdir m4
<<
ConfigureParams: --disable-static
CompileScript: <<
  autoreconf -fi
  %{default_script}
  fink-package-precedence --prohibit-bdep=%n .
<<

SplitOff: <<
  Package: %N-shlibs
  Depends: libraptor2-shlibs
  Files: lib/%N.*.dylib
  Shlibs: <<
    %p/lib/%N.2.dylib 3.0.0 %n (>= 0.4.0-1)
  <<
  DocFiles: README COPYING
  Description: Shared libs for %N
<<
