Package: yaz5
Version: 5.38.0
Revision: 1
# ftp.indexdata.com has SSL cert failure, which causes curl to reject
# downloading
# github tagged item is missing files
# debian FTW!
#Source: https://ftp.indexdata.com/pub/yaz/yaz-%v.tar.gz
#Source: https://github.com/indexdata/yaz/archive/refs/tags/v%v.tar.gz
Source: mirror:debian:pool/main/y/yaz/yaz_%v.orig.tar.gz
Source-Checksum: SHA256(c35f3994d382b42c43954253c1f24d1c0f93f0cb960532b69efa399b31b39b10)
SourceRename: yaz-%v.tar.gz
Conflicts: yaz
Replaces: yaz
Depends: <<
	%N-shlibs (= %v-%r),
	gnutls30-3.7-shlibs,
	libiconv,
	libncurses5-shlibs,
	libxml2.16-shlibs,
	libxslt-shlibs,
	readline8-shlibs
<<
BuildDepends: <<
	fink-package-precedence,
	gnutls30-3.7,
	libiconv-dev,
	libicu72-dev,
	libncurses5,
	libxml2-bin,
	libxml2.16,
	libxslt,
	pkgconfig,
	readline8
<<
Maintainer: Jack Fink <jackfink@users.sourceforge.net>
Homepage: https://www.indexdata.com/resources/software/yaz/
License: BSD
BuildDependsOnly: Yes
Description: Toolkit for Z39.50 applications
# Direct link to what is directly used; don't over-publish internal
# dependencies.
PatchFile: %n.patch
PatchFile-MD5: 676671e959b94df53546144bb215921f
PatchScript: <<
	%{default_script}
	perl -pi -e 's/(-version-info)/-no-undefined \1/' src/Makefile.in
<<
SetCFLAGS: -Os
ConfigureParams: <<
	--enable-dependency-tracking \
	--disable-static
<<
CompileScript: <<
	%{default_script}
	fink-package-precedence --prohibit-bdep=%n .
<<
InfoTest: <<
	TestScript: <<
		make check || exit 2
		fink-package-precedence --prohibit-bdep=%n . || exit 2
	<<
<<
InstallScript: make install DESTDIR=%d
DocFiles: ChangeLog LICENSE:COPYING NEWS README.md
Splitoff: <<
	Package: %N-shlibs
	Description: Shared libraries for Z39.50 applications
	Depends: <<
		gnutls30-3.7-shlibs,
		libiconv,
		libicu72-shlibs,
		libxml2.16-shlibs,
		libxslt-shlibs
	<<
	Files: <<
		lib/libyaz.5.dylib
		lib/libyaz_server.5.dylib
		lib/libyaz_icu.5.dylib
		share/yaz
	<<
	Shlibs: <<
		%p/lib/libyaz.5.dylib 10.0.0 %n (>= 5.38.0-1)
		%p/lib/libyaz_server.5.dylib 10.0.0 %n (>= 5.38.0-1)
		%p/lib/libyaz_icu.5.dylib 10.0.0 %n (>= 5.38.0-1)
	<<
	DocFiles: LICENSE:COPYING
<<
