Package: hwloc15-shlibs
Version: 2.9.3
Revision: 1
Source: https://download.open-mpi.org/release/hwloc/v2.9/hwloc-%v.tar.bz2
Source-Checksum: SHA256(5c4062ce556f6d3451fc177ffb8673a2120f81df6835dea6a21a90fbdfff0dec)
BuildDepends: <<
	cairo,
	libncurses5,
	libxml2.16
<<
Depends: <<
	libxml2.16-shlibs
<<
# See: https://github.com/open-mpi/hwloc/issues/639
PatchFile: %n.patch
PatchFile-MD5: 21d0dac804dda07b3303dacec8b23b32
PatchScript: <<
	%{default_script}
	perl -pi -e 's|-framework |-Wl,-framework,|g' configure
<<
ConfigureParams: <<
	--without-x \
	--libexecdir=%p/lib \
	--disable-silent-rules
<<
InstallScript: <<
	make install DESTDIR=%d
<<
InfoTest: TestScript: make check || exit 2
Shlibs: <<
	%p/lib/libhwloc.15.dylib 22.0.0 %n (>= 2.9.0-1)
<<
SplitOff: <<
	Package: hwloc15-dev
	Depends: %N (= %v-%r)
	BuildDependsOnly: true
	Conflicts: hwloc-dev, hwloc15-dev
	Replaces: hwloc-dev, hwloc15-dev
	DocFiles: AUTHORS COPYING NEWS README
	Files: <<
		include
		lib/libhwloc.{dylib,la}
		lib/pkgconfig
		share/man/man3
	<<
<<
SplitOff2: <<
	Package: hwloc
	Depends: <<
		%N (>= %v-%r),
		cairo-shlibs,
		libncurses5-shlibs,
		libxml2.16-shlibs
	<<
	DocFiles: AUTHORS COPYING NEWS README
	Files: <<
		bin
		share/applications
		share/bash-completion
		share/doc/hwloc
		share/hwloc
		share/man
	<<
<<
###
DocFiles: AUTHORS COPYING NEWS README
###
Description: Portable Hardware Locality
DescDetail: <<
The Portable Hardware Locality (hwloc) software package provides a
portable abstraction (across OS, versions, architectures, ...) of 
the hierarchical topology of modern architectures, including NUMA
memory nodes, sockets, shared caches, cores and simultaneous
multithreading.
<<
