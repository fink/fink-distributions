Package: libimobiledevice-glue10.0-shlibs
Version: 1.3.2
Revision: 1
Description: Common library used by libimobiledevice
License: GPL/LGPL
Maintainer: None <fink-devel@lists.sourceforge.net>

# Dependencies:
Depends: <<
	libplist20.4-shlibs
<<
BuildDepends: <<
	libplist20.4,
	fink-package-precedence,
	pkgconfig (>= 0.9.0-1)
<<

# Unpack Phase:
Source: https://github.com/libimobiledevice/libimobiledevice-glue/releases/download/%v/libimobiledevice-glue-%v.tar.bz2
Source-Checksum: SHA256(6489a3411b874ecd81c87815d863603f518b264a976319725e0ed59935546774)

ConfigureParams: <<
	--disable-static \
	--disable-silent-rules
<<

# Compile Phase:
CompileScript: <<
	%{default_script}
	fink-package-precedence --prohibit-bdep=libimobiledevice-glue10.0-shlibs-dev .
<<
InfoTest: <<
	TestScript:  make check || exit 2
<<
# Install Phase:
InstallScript: <<
	make install DESTDIR=%d
<<

Shlibs: <<
	%p/lib/libimobiledevice-glue-1.0.0.dylib   4.0.0 %n (>= 1.3.2-1)
<<
DocFiles: COPYING NEWS README.md

SplitOff: <<
	Package: libimobiledevice-glue10.0-dev
	Depends:   %N (>= %v-%r)
	BuildDependsOnly: true
	Files: <<
		include
		lib/libimobiledevice-glue-1.0.{dylib,la}
		lib/pkgconfig
	<<
	DocFiles: COPYING NEWS README.md
<<

Homepage: https://libimobiledevice.org
DescDetail: <<
Library with common code used by the libraries and tools around the
libimobiledevice project.
The main functionality provided by this library are socket helper
functions and a platform independent thread/mutex implementation.
Besides that it comes with a number of string, file, and plist helper
functions, as well as some other commonly used code that was originally
duplicated in the dedicated projects.
<<
