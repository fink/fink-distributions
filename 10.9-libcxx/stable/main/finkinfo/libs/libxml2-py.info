Info2: <<
Package: libxml2-py%type_pkg[python]
Version: 2.15.4
Revision: 1
Maintainer: Daniel Macks <dmacks@netspace.org>
# Not compatible with python < 3.6
Type: python (3.10 3.15)
Depends: <<
	libxml2.16-shlibs (>= %v-1),
	(%type_pkg[python] << 315) python%type_pkg[python],
	(%type_pkg[python] >= 315) python%type_pkg[python]-minimal
<<
BuildDepends: <<
	fink (>= 0.32.0),
	fink-package-precedence,
	libiconv-dev,
	libxml2.16 (>= %v-1),
	pkgconfig (>= 1.0),
	readline8
<<
Source: mirror:gnome:sources/libxml2/2.15/libxml2-%v.tar.xz
Source-Checksum: SHA256(98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821)
PatchFile: %{ni}.patch
PatchFile-MD5: 39154325d7e55c04e85ee8cdcff45199
PatchScript: <<
	%{default_script}
	# Use prebuilt docs, with "new" timestamps, to avoid
	# BDep:doxygen and dep cycle via BDep:docbook-xsl. See:
	# https://github.com/fink/fink-distributions/issues/1298
	cp -r dist-doc/* doc
	rm doc/Makefile
	# Don't fail if doxygen isn't found (we wouldn't be using it
	# anyway)
	perl -pi -e 's/as_fn_error/echo "Ignoring doxygen anyway" / if /doxygen/' configure
<<
ConfigureParams: <<
	--with-iconv=%p \
	--with-history \
	--disable-static \
	--with-python \
	PYTHON=%p/bin/python%type_raw[python] \
	--with-legacy \
	--enable-dependency-tracking \
	--disable-silent-rules \
	--with-docs \
	--docdir=%p/share/doc/%n \
	XSLTPROC=/usr/bin/xsltproc
<<
CompileScript: <<
	./configure %c
	make -C doc
	make -C python
	fink-package-precedence .
<<
InfoTest: <<
	TestScript: <<
		make -C python tests || exit 2
		fink-package-precedence --prohibit-bdep=%n . || exit 2
	<<
<<
InstallScript: <<
	make -C python install DESTDIR=%d docsdir=%p/share/doc/%n exampledir=%p/share/doc/%n/examples
<<
DocFiles: Copyright NEWS README.md python/README:README.py-bindings
Description: Python bindings for libxml2 library
DescPackaging: <<
	Patch python module makefiles to use installed libxml2 not
	locally-built. See:
	http://bugzilla.gnome.org/show_bug.cgi?id=341290

	Fix tests target so that it gives cleaner feedback and
	propagates failures correctly to the caller's shell.
<<
License: BSD
Homepage: http://www.xmlsoft.org/
<<
