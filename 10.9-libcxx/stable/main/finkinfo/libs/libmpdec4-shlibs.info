Package: libmpdec4-shlibs
Version: 4.0.1
Revision: 1
Source: https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-%v.tar.gz
Source-Checksum: SHA256(96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8)
Source2: http://speleotrove.com/decimal/dectest.zip
Source2-Checksum: SHA256(b70a224cd52e82b7a8150aedac5efa2d0cb3941696fd829bdbe674f9f65c3926)
Source2ExtractDir: testdata
PatchFile: %n.patch
PatchFile-MD5: b73dc7ac2d7f884aa91de0fe5bf8120b
PatchScript: <<
	%{default_script}
	perl -pi -e 's/(PACKAGE_TARNAME)\s*=.*/\1=%n/' configure
	mv ../testdata tests
<<
BuildDepends: <<
	fink-package-precedence
<<
GCC: 4.0
SetCFLAGS: -MD
SetCXXFLAGS: -MD
ConfigureParams: --disable-static
CompileScript: <<
	%{default_script}
	fink-package-precedence --depfile-ext='\.d' --prohibit-bdep=libmpdec4-dev .
<<
InfoTest: <<
	TestScript: make check || exit 2
<<
InstallScript: <<
	make install DESTDIR=%d PACKAGE_TARNAME=%n
<<
DocFiles:  CHANGELOG.txt COPYRIGHT.txt README.txt
Shlibs: <<
	%p/lib/libmpdec.4.dylib 4.0.0 %n (>= 4.0.1-1)
	%p/lib/libmpdec++.4.dylib 4.0.0 %n (>= 4.0.1-1)
<<
SplitOff: <<
	Package: libmpdec4-dev
	Depends: %N (= %v-%r)
	BuildDependsOnly: true
	Files: <<
		include
		lib/pkgconfig
		lib/libmpdec.dylib
		lib/libmpdec++.dylib
		share/man
	<<
	DocFiles:  CHANGELOG.txt COPYRIGHT.txt README.txt
<<


Description: Decimal floating point arithmetic
Homepage: https://www.bytereef.org/mpdecimal
License: BSD
Maintainer: Daniel Macks <dmacks@netspace.org>
