Package: libde265.0-shlibs
Version: 1.1.3
Revision: 1
# release tarball does not contain enc265 tool
#Source: https://github.com/strukturag/libde265/releases/download/v%v/libde265-%v.tar.gz
Source: https://github.com/strukturag/libde265/archive/refs/tags/v%v.tar.gz
Source-Checksum: SHA256(189baa08fd6d2dd34db099de411bd6b2e6bd5eb88e81236a3d0fa3826b9715c4)
SourceRename: libde265-%v.tar.gz
BuildDepends: <<
	cmake (>= 3.17),
	fink-package-precedence,
	pkgconfig,
	sdl
<<

# Upstream switching from libtool to cmake lost mac-specific ABI
# versioning, so we patch CMakeLists.txt to make sure c_v increments
# properly (we can stop doing this when install_name changes).
#  * version 1.0.11: c_v 2.0.0
#  * version 1.1.3: c_v 3.0.0 (symbols added; none removed/broken)
PatchFile: %n.patch
PatchFile-MD5: bd67b23eed8faabf99661212fe8306e1
GCC: 4.0
# sherlock inspector program is a heavy added pile of deps
CompileScript: <<
	#!/bin/sh -ev
	mkdir -p build
	pushd build
		cmake \
			-DCMAKE_INSTALL_PREFIX="%p" \
			-DCMAKE_INSTALL_NAME_DIR=%p/lib \
			-DCMAKE_VERBOSE_MAKEFILE=ON \
			-DCMAKE_CXX_FLAGS:STRING="-MD" \
			-DENABLE_SHERLOCK265=OFF \
		..
		make
	popd
	fink-package-precedence --depfile-ext='\.d' --prohibit-bdep=libde265.0-dev .
<<
InstallScript: <<
#!/bin/sh -ev
	pushd build
		make install DESTDIR=%d
	popd
<<
DocFiles: AUTHORS COPYING README.md
Shlibs: %p/lib/libde265.0.dylib 3.0.0 %n (>= 1.1.3-1)
SplitOff: <<
	Package: libde265.0-dev
	Depends: %N (= %v-%r)
	BuildDependsOnly: true
	Files: <<
		include
		lib/libde265.dylib
		lib/pkgconfig
		lib/cmake
	<<
	DocFiles: AUTHORS COPYING README.md
<<
SplitOff2: <<
	Package: de265
	Depends: <<
		%N (>= %v-%r),
		sdl-shlibs
	<<
	Files: <<
		bin
	<<
	DocFiles: AUTHORS COPYING README.md
<<
