Package: libtatsu0-shlibs
Version: 1.0.5
Revision: 1
Description: Library for Apple Tatsu signing server
License: LGPL
Maintainer: None <fink-devel@lists.sourceforge.net>

# Dependencies:
Depends: <<
	libcurl4-shlibs (>= 7),
	libplist20.4-shlibs (>= 2.6.0)
<<
BuildDepends: <<
	libcurl4 (>= 7),
	libplist20.4 (>= 2.6.0),
	fink-package-precedence,
	pkgconfig (>= 0.9.0-1)
<<

# Unpack Phase:
Source: https://github.com/libimobiledevice/libtatsu/releases/download/%v/libtatsu-%v.tar.bz2
Source-Checksum: SHA256(536fa228b14f156258e801a7f4d25a3a9dd91bb936bf6344e23171403c57e440)

ConfigureParams: <<
	--disable-static \
	--disable-silent-rules
<<

# Compile Phase:
CompileScript: <<
	%{default_script}
	fink-package-precedence --prohibit-bdep=libtatsu0-dev .
<<
InfoTest: <<
	TestScript:  make check || exit 2
<<
# Install Phase:
InstallScript: <<
	make install DESTDIR=%d
<<

Shlibs: <<
	%p/lib/libtatsu.0.dylib   1.0.0 %n (>= 1.0.5-1)
<<
DocFiles: COPYING NEWS README.md

SplitOff: <<
	Package: libtatsu0-dev
	Depends: %N (= %v-%r)
	BuildDependsOnly: true
	Files: <<
		include
		lib/libtatsu.{dylib,la}
		lib/pkgconfig
	<<
	DocFiles: COPYING NEWS README.md
<<

Homepage: https://libimobiledevice.org
DescDetail: <<
This library is part of the libimobiledevice project. The main purpose
of this library is to allow creating TSS request payloads, sending them
to Apple's TSS server, and retrieving and processing the response.

The code was originally part of idevicerestore and has been split out to
its own library, while obviously idevicerestore will remain the main
consumer.
<<
