Info2: <<
Package: trove-classifiers-py%type_pkg[python]
Version: 2025.12.1.14
Revision: 1
Distribution: <<
<<
Type: python (3.7 3.8 3.9 3.10)
Description: Canonical source for classifiers on PyPI
License: BSD
# Free to modify, update, and take over
Maintainer: Hanspeter Niederstrasser <nieder@users.sourceforge.net>

Homepage: https://pypi.org/project/trove-classifiers
Source: https://files.pythonhosted.org/packages/source/t/trove-classifiers/trove_classifiers-%v.tar.gz
Source-Checksum: SHA256(a74f0400524fc83620a9be74a07074b5cbe7594fd4d97fd4c2bfde625fdc1633)
Depends: <<
	python%type_pkg[python]
<<
BuildDepends: <<
	bootstrap-modules-py%type_pkg[python],
	setuptools-tng-py%type_pkg[python] (>= 68)
<<
# Debian's patch to set version and avoid needing calver
PatchFile: %{Ni}_setup_version.patch
PatchFile-MD5: 4565790c4ce0306d7a1cc6293ac60d6a
CompileScript: DEB_VERSION_UPSTREAM=%v PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m build --wheel --no-isolation --skip-dependency-check

# tests need current version to be installed to fully finish, even if PATH and PYTHONPATH are set
# https://github.com/pypa/trove-classifiers/issues/219
#InfoTest: <<
#	TestDepends: <<
#		pytest-py%type_pkg[python]
#	<<
#	TestScript: <<
#		#!/bin/sh -ev
#		#don't look for the exe in %p, but in local path
#		perl -pi -e 's|\{BINDIR}\/||g' tests/test_cli.py
#		PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m installer --destdir %b/tempdist dist/*.whl
#		PATH=%b/tempdist%p/bin PYTHONPATH=%b/tempdist%p/lib/python%type_pkg[python]/site-packages %p/bin/python%type_raw[python] -m pytest || exit 2
#	<<
#<<
InstallScript: <<
	#!/bin/sh -ev
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m installer --destdir %d dist/*.whl
	for i in trove-classifiers ; do
		mv %i/bin/$i %i/bin/$i-py%type_raw[python]
	done
<<
PostInstScript: <<
	update-alternatives --verbose --install %p/bin/trove-classifiers trove-classifiers %p/bin/trove-classifiers-py%type_raw[python] %type_pkg[python]
<<
PreRmScript: <<
	if [ $1 != "upgrade" ]; then
		update-alternatives --verbose --remove trove-classifiers %p/bin/trove-classifiers-py%type_raw[python]
	fi
<<

DocFiles: LICENSE README.md
DescDetail: <<
Canonical source for classifiers on PyPI.

Classifiers categorize projects per PEP 301. Use this package to
validate classifiers in packages for PyPI upload or download.
<<
<<
