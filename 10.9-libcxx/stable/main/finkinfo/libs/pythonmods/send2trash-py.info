# -*- coding: ascii; tab-width: 4 -*-
Info2: <<
Package: send2trash-py%type_pkg[python]
# 2.0+ requires NEWSETUPTOOLS (>= 75.3.1)
Version: 1.8.3
Revision: 1
Type: python (3.8 3.9 3.10)

Description: Send file to trash natively under MacOS X
DescDetail: <<
Send2Trash is a small package that sends files to the Trash (or Recycle Bin)
natively and on all platforms. On OS X, it uses native FSMoveObjectToTrashSync
Cocoa calls, on Windows, it uses native (and ugly) SHFileOperation win32 calls.
On other platforms, if PyGObject and GIO are available, it will use this.
Otherwise, it will fallback to its own implementation of the trash
specifications from freedesktop.org.
<<
DescPort: <<
``ctypes`` is used to access native libraries, so no compilation is necessary;
pytest implemented, but no actual tests present.
<<
Maintainer: Derek Homeier <dhomeie@gwdg.de>
License: BSD
Homepage: https://github.com/hsoft/send2trash

Source: https://files.pythonhosted.org/packages/source/S/Send2Trash/Send2Trash-%v.tar.gz
Source-Checksum: SHA256(b18e7a3966d99871aefeb00cfbcfdced55ce4871194810fc71f4aa484b953abf)
# issue35 fixed in v2.0.0
PatchFile: %{ni}-issue35.patch
PatchFile-MD5: 8dd7d41560d6f2aa5a268e09f97ca745

Depends: python%type_pkg[python]
BuildDepends: <<
	bootstrap-modules-py%type_pkg[python] (>= 20260125),
	setuptools-tng-py%type_pkg[python]
<<

PatchScript: <<
	%{default_script}
	# test fails under fink-bld with insufficient permissions
	perl -pi -e 's|def test_trash|$&_fails_fink_bld|' tests/test_script_main.py
<<
CompileScript: <<
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m build --wheel --no-isolation --skip-dependency-check
<<

InfoTest: <<
    TestDepends: pytest-py%type_pkg[python]
    TestScript: PYTHONPATH=%b/build/lib %p/bin/pytest-%type_raw[python] -k 'not test_trash_fails_fink_bld' -vv || exit 2
<<

InstallScript: <<
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m installer --destdir %d dist/*.whl
	mv %i/bin/send2trash %i/bin/send2trash-py%type_raw[python]
<<
PostInstScript: <<
	update-alternatives --verbose --install %p/bin/send2trash send2trash %p/bin/send2trash-py%type_raw[python] %type_pkg[python]
<<
PreRmScript: <<
	if [ $1 != "upgrade" ]; then
		update-alternatives --verbose --remove send2trash %p/bin/send2trash-py%type_raw[python]
	fi
<<

DocFiles: CHANGES.rst README.rst PKG-INFO LICENSE
# Info2
<<
