Package: libexempi8-shlibs
Version: 2.6.6
Revision: 2
Source: http://libopenraw.freedesktop.org/download/exempi-%v.tar.bz2
Source-Checksum: SHA256(7513b7e42c3bd90a58d77d938c60d2e87c68f81646e7cb8b12d71fe334391c6f)
BuildDepends: <<
	expat1,
	fink-package-precedence,
	libiconv-dev
<<
Depends: <<
	expat1-shlibs
<<
GCC: 4.0
PatchFile: %n.patch
PatchFile-MD5: 76f6e617f904e6df8a37abf25dc699dd
PatchScript: <<
	%{default_script}
	perl -pi -e 's/(-version-info)/-no-undefined \1/' exempi/Makefile.in
<<
ConfigureParams: --disable-static --disable-unittest
CompileScript: <<
	%{default_script}
	fink-package-precedence --prohibit-bdep=libexempi8-dev .
<<
InfoTest: <<
	# lots of hangs if using valgrind unittests
#	TestConfigureParams: --enable-unittest --with-boost=%p/opt/boost-1_55
#	TestDepends: boost1.55-nopython  # needed for unittest
	TestScript: <<
		DYLD_LIBRARY_PATH=%b/exempi/.libs make check || exit 2
		fink-package-precedence --prohibit-bdep=libexempi8-dev .
	<<
<<
InstallScript: <<
	make install DESTDIR=%d
<<
DocFiles: AUTHORS ChangeLog CODE_OF_CONDUCT.md CONTRIBUTING.md COPYING ORIGINSTORY.md README* TODO
Shlibs: %p/lib/libexempi.8.dylib 10.0.0 %n (>= 2.6.6-1)
SplitOff: <<
	Package: libexempi8-dev
	Depends: %N (= %v-%r)
	BuildDependsOnly: true
	Conflicts: <<
		libexempi3-dev,
		libexempi8-dev
	<<
	Replaces: <<
		libexempi3-dev,
		libexempi8-dev
	<<
	Files: <<
		lib/libexempi.{dylib,la}
		lib/pkgconfig
		include
	<<
	DocFiles: AUTHORS ChangeLog CODE_OF_CONDUCT.md CONTRIBUTING.md COPYING ORIGINSTORY.md README* TODO
<<
SplitOff2: <<
	Package: exempi
	Depends: <<
		%N (>= %v-%r),
		expat1-shlibs
	<<
	Files: <<
		bin
	<<
	DocFiles: AUTHORS ChangeLog CODE_OF_CONDUCT.md CONTRIBUTING.md COPYING ORIGINSTORY.md README* TODO
<<
Description: XMP metadata parser
License: BSD
Homepage: https://launchpad.net/exempi
