Package: libicu79-shlibs
Version: 79.1
Revision: 1

Source: https://github.com/unicode-org/icu/releases/download/release-%v/icu4c-%v-sources.tgz
Source-Checksum: SHA256(06fa63ecb521048f8082f12ad988f6b678d90cbd88aafce24cbc94902b191d99)
SourceDirectory: icu

BuildDepends: <<
	fink-package-precedence,
	flag-sort
<<

PatchFile: %n.patch
PatchFile-MD5: 04eef74ab8d9ca9651b6a511fa117eff
SetCC: flag-sort -r gcc
SetCXX: flag-sort -r g++
ConfigureParams: --enable-shared --disable-static --enable-rpath
UseMaxBuildJobs: false
CompileScript: <<
	#!/bin/sh -ev
	mkdir build
	pushd build
		../source/configure %c
		make
		fink-package-precedence --depfile-ext=.d --headers --libs \
			--prohibit-bdep=libicu48-dev,libicu55-dev,libicu67-dev,libicu72-dev,libicu79-dev .
	popd
<<
InfoTest: <<
	TestScript: <<
		#!/bin/sh -ev
		export ICU_DATA=%b/build/data/out/build
		pushd build
			make -j1 check || exit 2
		popd
	<<
<<
InstallScript: <<
#!/bin/sh -ex
	pushd build
		make DESTDIR="%d" install
	popd
<<
DocFiles: *.css *.html
Shlibs: <<
	%p/lib/libicudata.79.dylib	79.0.0  %n (>= 79.1-1)
	%p/lib/libicui18n.79.dylib	79.0.0  %n (>= 79.1-1)
	%p/lib/libicuio.79.dylib	79.0.0  %n (>= 79.1-1)
	%p/lib/libicutest.79.dylib	79.0.0  %n (>= 79.1-1)
	%p/lib/libicutu.79.dylib	79.0.0  %n (>= 79.1-1)
	%p/lib/libicuuc.79.dylib	79.0.0  %n (>= 79.1-1)
<<
SplitOff: <<
	Package: libicu79-dev
	Depends: %N (= %v-%r)
	BuildDependsOnly: true
	Conflicts: <<
		libicu48-dev,
		libicu55-dev,
		libicu67-dev,
		libicu72-dev,
		libicu79-dev
	<<
	Replaces: <<
		libicu48-dev,
		libicu55-dev,
		libicu67-dev,
		libicu72-dev,
		libicu79-dev
	<<
	Files: <<
		bin
		include
		lib/icu
		lib/libicudata.dylib
		lib/libicui18n.dylib
		lib/libicuio.dylib
		lib/libicutest.dylib
		lib/libicutu.dylib
		lib/libicuuc.dylib
		lib/pkgconfig
		sbin
		share/icu
		share/man
	<<
	DocFiles: *.css *.html
<<
