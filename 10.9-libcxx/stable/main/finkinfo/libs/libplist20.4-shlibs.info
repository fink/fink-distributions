Package: libplist20.4-shlibs
Version: 2.7.0
Revision: 1
Description: Library to handle Apple Property List files
License: GPL/LGPL

# Dependencies:
BuildDepends: <<
	pkgconfig (>= 0.9.0-1),
	fink-package-precedence
<<

GCC: 4.0

# Unpack Phase:
Source: https://github.com/libimobiledevice/libplist/releases/download/%v/libplist-%v.tar.bz2
Source-Checksum: SHA256(7ac42301e896b1ebe3c654634780c82baa7cb70df8554e683ff89f7c2643eb8b)

ConfigureParams: <<
	--disable-static \
	--without-cython
<<

# Compile Phase:
CompileScript: <<
	%{default_script}
	fink-package-precedence --prohibit-bdep=libplist20.4 .
<<
InfoTest: <<
	TestScript:  make check || exit 2
<<
# Install Phase:
InstallScript: <<
	make install DESTDIR=%d
<<

Shlibs: <<
	%p/lib/libplist-2.0.4.dylib   12.0.0 %n (>= 2.7.0-1)
	%p/lib/libplist++-2.0.4.dylib 12.0.0 %n (>= 2.7.0-1)
<<
DocFiles: AUTHORS COPYING* NEWS README.md

SplitOff: <<
	Package: libplist20.4
	Depends:   %N (>= %v-%r)
	Conflicts: <<
		libplist,
		libplist1,
		libplist20.4
	<<
	Replaces: <<
		libplist,
		libplist1,
		libplist20.4
	<<
	BuildDependsOnly: true
	Files: <<
		include
		lib/libplist-2.0.{dylib,la}
		lib/libplist++-2.0.{dylib,la}
		lib/pkgconfig
	<<
	DocFiles: AUTHORS COPYING* NEWS README.md
<<

Splitoff2: <<
	Package: libplist-bin
	Description: Command line tool "plistutil" from libplist
	Depends: %N (>= %v-1)
	Files: <<
		bin
		share/man
	<<
	DocFiles: AUTHORS COPYING* NEWS README.md
<<

DescPort: <<
Python bindings are pushed to a separate package.

Previous versions by Karl-Michael Schindler.
<<

Homepage: https://libimobiledevice.org
Maintainer: None <fink-devel@lists.sourceforge.net>

