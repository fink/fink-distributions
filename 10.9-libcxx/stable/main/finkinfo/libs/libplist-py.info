Info2: <<
Package: libplist-py%type_pkg[python]
Type: python (3.8 3.9 3.10)
Version: 2.7.0
Revision: 1
Description: Python bindings for libplist
License: GPL/LGPL

# Dependencies:
BuildDepends: <<
	cython-py%type_pkg[python],
	libplist20.4 (>= %v-1)
<<
Depends: <<
	python%type_pkg[python],
	libplist20.4-shlibs (>= %v-1)
<<
GCC: 4.0

# Unpack Phase:
Source: https://github.com/libimobiledevice/libplist/releases/download/%v/libplist-%v.tar.bz2
Source-Checksum: SHA256(7ac42301e896b1ebe3c654634780c82baa7cb70df8554e683ff89f7c2643eb8b)

UseMaxBuildJobs: false

# Compile Phase:
ConfigureParams: <<
	--disable-silent-rules \
	PYTHON=%p/bin/python%type_raw[python] \
	ac_cv_path_CYTHON=%p/bin/cython-py%type_pkg[python]
<<
CompileScript: <<
	./configure %c
	make CFLAGS='-Wno-missing-field-initializers -Wno-deprecated-declarations'
<<

# Install Phase:
InstallScript: <<
#!/bin/sh -ev
	cd cython
	make install DESTDIR=%d
<<
DocFiles: AUTHORS COPYING* NEWS README.md

SplitOff: <<
	Package: %N-dev
	BuildDependsOnly: true
	Depends: %N
	Conflicts: <<
		libplist-py27-dev,
		libplist-py38-dev,
		libplist-py39-dev,
		libplist-py310-dev
	<<
	Replaces: <<
		libplist-py27-dev,
		libplist-py38-dev,
		libplist-py39-dev,
		libplist-py310-dev
	<<
	Files: include
<<

# Additional Info

DescPort: <<
The automatic detection of python does not work. It easily returns a mix of 
system and fink paths of the python executable, the include and the lib folder.

Previous versions by Karl-Michael Schindler.
<<
DescPackaging: <<
* To build the python bindings, need to build the entire library, but
only install the bindings.
<<

Homepage: https://libimobiledevice.org
Maintainer: None <fink-devel@lists.sourceforge.net>
<<
