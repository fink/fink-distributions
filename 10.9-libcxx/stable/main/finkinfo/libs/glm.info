Package: glm
Version: 1.0.3
Revision: 1
Description: OpenGL Mathematics library
DescDetail: <<
OpenGL Mathematics (GLM) is a header only C++ mathematics library for
graphics software based on the OpenGL Shading Language (GLSL)
specifications.
<<
Homepage: http://glm.g-truc.net/
License: BSD
Maintainer: Daniel Johnson <daniel@daniel-johnson.org>

#Source: mirror:sourceforge:ogl-math/%n-%v/%n-%v.zip
Source: https://github.com/g-truc/glm/archive/refs/tags/%v.tar.gz
Source-Checksum: SHA256(6775e47231a446fd086d660ecc18bcd076531cfedd912fbd66e576b118607001)
SourceRename: %n-%v.tar.gz
PatchScript: <<
	# Disable a failing test: FTBFS due to bug in test program.
	# See: https://github.com/g-truc/glm/issues/1466
	perl -pi -e 's/(glmCreateTestGTC\(gtc_matrix_transform\))/#\1/' test/gtc/CMakeLists.txt
<<

BuildDependsOnly: true

BuildDepends: cmake
CompileScript: <<
#!/bin/sh -ev
	cmake_params=`echo "%c" | sed "s,--prefix=%p,,"`
	cmake -DCMAKE_INSTALL_PREFIX=%p $cmake_params .
	make
<<
InstallScript: <<
	make install DESTDIR=%d
<<

DocFiles: copying.txt manual.md readme.md doc/manual.pdf

InfoTest:<<
	TestConfigureParams: -DGLM_BUILD_TESTS=on
	TestScript: <<
		make test || exit 2
	<<
<<
