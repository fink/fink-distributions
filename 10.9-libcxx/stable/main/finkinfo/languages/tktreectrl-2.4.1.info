Package: tktreectrl
Version: 2.4.1
Revision: 203
Description: Flexible listbox widget for Tk
Maintainer: Steffen Schmidt <Steffen.Schmidt@Tuebingen.MPG.de>
DescDetail: <<
<<
License: BSD
Homepage: http://%n.sourceforge.net/ 
Source: mirror:sourceforge:%n/%n-%v.tar.gz
Source-Checksum: SHA256(c2d19cfc7ce8b150cb50a6b63dc6327c91fb71f76b4f2947e0334a15d5f869d3)
Source2: mirror:debian:pool/main/t/%n/%n_%v-4.debian.tar.xz
Source2-Checksum: SHA256(5d2d9de2b6b75ee689b1dde5c9512bd75446050f22c382af5440b5aea65e861d)
BuildConflicts: lclint
# lclint installs %p/lib/Makefile, which leads configure to believe
# it is using tcltk from tcltk's builddir, hence failure
BuildDepends: <<
	fink (>= 0.32),
	fink-buildenv-modules (>= 0.1.3-1),
	tcl-libdirs,
	tcltk-dev (>= 8.6.1)
<<
Depends: tcltk (>= 8.6.1)
Replaces: %N-shlibs
SourceDirectory: %n-%v
ConfigureParams: <<
	--with-tcl=%p/lib \
	--with-tk=%p/lib \
	--x-includes=$X11_BASE_DIR/include \
	--x-libraries=$X11_BASE_DIR/lib \
	--libdir=%p/lib/tcl-libdirs/8.6
<<
DocFiles: README.txt license.terms 
PatchScript:  <<
	# Debian's fixes are not just for tcl9:)
	patch -p1 < ../debian/patches/tcl9.patch
	perl -pi -e 's,LD_LIBRARY_PATH_VAR="DYLD_LIBRARY_PATH",,' ./configure
	perl -pi -e 's|\@SHLIB_LD\@|\@SHLIB_LD\@  -install_name %p/lib/tcl-libdirs/8.6/treectrl%v/libtreectrl2.4.dylib|g'  Makefile.in
<<
CompileScript: <<
#!/bin/sh -ev
	. %p/sbin/fink-buildenv-helper.sh
	%{default_script}
<<
# Testsuite requires access to display but passes
# when run manually.
#InfoTest: TestScript: make test || exit 2
InstallScript: <<
	make install DESTDIR=%d
<<
Shlibs: !%p/lib/tcl-libdirs/8.6/treectrl%v/libtreectrl2.4.dylib
