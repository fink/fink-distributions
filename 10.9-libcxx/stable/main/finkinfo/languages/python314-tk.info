InstallScript: <<
#!/bin/sh -ex
	# Rebuild _sysconfigdata.py if we ran tests.
	make
	# _sysconfigdata.py contains build-time variables that point to %b.
	# This is harmless but upsets fink's validator.
	# Change to %p/lib to make fink happy.
	perl -pi -e 's,%b,%p/lib/python%type_raw[python]/config-%type_raw[python]-darwin,' `ls -d %b/build/lib*`/_sysconfigdata__darwin_darwin.py
	# Don't propagate -lintl to other packages.
	perl -pi -e 's/-lintl //' `ls -d %b/build/lib*`/_sysconfigdata__darwin_darwin.py
	# Remove stray .pyc that get made during tests (including preliminary ones in CompileScript) to keep validator happy.
	find ./Lib ./Parser ./Tools ./build -name '*.pyc' -delete
	# Change interpreter name in scripts to versioned executable.
	perl -pi -e 's|(/usr/bin/env python)(3?)$|${1}%type_raw[python]|' ./Tools/scripts/*.py
	# install fails with -j greater than 1
	export MAKEFLAGS=-j1
	make install DESTDIR=%d

	# Fix all main things to be python-versioned filenames with unversioned symlinks to them.
	pushd %i/bin
		for f in idle3 pydoc3; do
			mv ${f} ${f}-%type_raw[python]
			ln -s ${f}-%type_raw[python] ${f}
		done
	popd

	# For these special component packages, we first installed
	# everything as usual. Now we move everything aside, move back
	# what we want, and nuke everything else. Ugly, no?
	pushd %i
		mkdir ../blib
		mv * ../blib

		mkdir -p lib/python%type_raw[python]/lib-dynload
		mv ../blib/lib/python%type_raw[python]/lib-dynload/_tkinter*.so lib/python%type_raw[python]/lib-dynload
		mv ../blib/lib/python%type_raw[python]/tkinter lib/python%type_raw[python]

		mkdir -p bin
		mv ../blib/bin/idle3?* bin
		mkdir -p lib/python%type_raw[python]
		mv ../blib/lib/python%type_raw[python]/idlelib lib/python%type_raw[python]

		rm -r ../blib
	popd
<<
