PatchScript: <<
	# This macro hard-codes the library path into the install_name of the shared libraries - which is not what we want!
	perl -pi -e 's|\${CMAKE_INSTALL_PREFIX}/lib|\${CMAKE_INSTALL_PREFIX}/\${HDF5_INSTALL_LIB_DIR}|' config/HDF5Macros.cmake
<<
CompileScript: <<
#!/bin/sh -ev
	. %p/sbin/fink-buildenv-cmake.sh
	mkdir build
	pushd build
	if [ "%type_raw[api]" = "1.8" ]; then
		set HDF5_API_VERSION="v18"
	elif [ "%type_raw[api]" = "1.10" ]; then
		set HDF5_API_VERSION="v110"
	elif [ "%type_raw[api]" = "1.12" ]; then
		set HDF5_API_VERSION="v112"
	elif [ "%type_raw[api]" = "1.14" ]; then
		set HDF5_API_VERSION="v114"
	elif [ "%type_raw[api]" = "2.0" ]; then
		set HDF5_API_VERSION="v200"
	fi
	cmake -G "Unix Makefiles" \
		$FINK_CMAKE_ARGS \
		-DHDF5_INSTALL_LIB_DIR=opt/hdf5.v%type_raw[api]/lib \
		-DHDF5_INSTALL_CMAKE_DIR=opt/hdf5.v%type_raw[api]/lib/cmake \
		-DHDF5_INSTALL_INCLUDE_DIR=opt/hdf5.v%type_raw[api]/include \
		-DBUILD_SHARED_LIBS:BOOL=ON \
		-DBUILD_STATIC_LIBS:BOOL=OFF \
		-DHDF5_BUILD_WITH_INSTALL_NAME:BOOL=ON \
		-DHDF5_ENABLE_ZLIB_SUPPORT:BOOL=ON \
		-DHDF5_ENABLE_SZIP_SUPPORT:BOOL=ON \
		-DSZIP_ROOT=%p \
		-Dlibaec_LIBRARY=%p/lib/libsz.dylib \
		-Dlibaec_INCLUDE_DIR=%p/include \
		-DHDF5_ENABLE_PARALLEL:BOOL=OFF \
		-DHDF5_ENABLE_CONCURRENCY:BOOL=OFF \
		-DHDF5_ENABLE_THREADSAFE:BOOL=OFF \
		-DHDF5_BUILD_FORTRAN:BOOL=OFF \
		-DHDF5_BUILD_JAVA:BOOL=OFF \
		-DHDF5_BUILD_CPP_LIB:BOOL=ON \
		-DHDF5_BUILD_HL_LIB:BOOL=ON \
		-DHDF5_DEFAULT_API_VERSION=$HDF5_API_VERSION \
		-DHDF5_BUILD_TOOLS:BOOL=ON \
		..
	make
	fink-package-precedence --depfile-ext='\.d' --prohibit-bdep=%N,hdf5.200.v1.8,hdf5.200.v1.10,hdf5.200.v1.12,hdf5.100.v1.8,hdf5.100.v1.10,hdf5.10,hdf5.10-oldapi,hdf5.9,hdf5.9-oldapi .
	popd
<<

InfoTest: <<
	TestScript: <<
#!/bin/sh -ev
		cd build
		ctest . -C Release -VV || exit 2
		cd ..
	<<
	TestSuiteSize: large
<<

InstallScript: <<
#!/bin/sh -ev
	cd build
	cmake --install . --prefix %i
	cd ..
	rm -rf %i/share # remove documentation files outside Fink's directory structure
<<

