#SetCC: gcc-fsf-%type_raw[gcc]
#SetCXX: g++-fsf-%type_raw[gcc]
#SetCFLAGS: -march=native
# Support for macOS's Accelerate framework was re-enabled in numpy/numpy#18874
# as numpy can get by with LAPACK 3.2.1.
# Nonetheless giving preference to external OpenBLAS here.
CompileScript: <<
    #!/bin/sh -ev
    NPY_BLAS_ORDER=openblas,accelerate
    NPY_LAPACK_ORDER=openblas,accelerate
    ATLAS=None
    darwin_vers=$(uname -r | cut -d. -f1)
    if [ %m != x86_64 ]; then
        CFLAGS='-O2 -mtune=native -march=armv8.5-a'
        CPU_OPTS='NEON NEON_FP16 NEON_VFPV4 ASIMD ASIMDHP ASIMDDP'
        %p/bin/python%type_raw[python] setup.py build --cpu-baseline "$CPU_OPTS"
    else
        if [ "$darwin_vers" -ge 18 ]; then
            CFLAGS='-O2 -mtune=native -march=ivybridge'
        else
            CFLAGS='-O2 -mtune=silvermont -march=westmere'
        fi
        NPY_BLAS_ORDER=openblas,accelerate NPY_LAPACK_ORDER=openblas,accelerate ATLAS=None %p/bin/python%type_raw[python] setup.py build
    fi
<<
InfoTest: <<
    TestDepends: <<
        gcc%type_raw[gcc]-compiler,
        cffi-py%type_pkg[python],
        hypothesis-py%type_pkg[python] (>= 6.24.1),
        pytest-py%type_pkg[python],
        typing-extensions-py%type_pkg[python]
    <<
    TestScript: touch %b/INSTALL_MAKE_CHECK
<<
InstallScript: <<
    #!/bin/sh -ev
    ATLAS=None %p/bin/python%type_raw[python] setup.py install --root %d

    if [ -f %b/INSTALL_MAKE_CHECK ]; then
        PATH=%i/bin:$PATH
        # Point to gfortran executables for f2py tests.
        export F90=gfortran-fsf-%type_raw[gcc]
        export F77=$F90
        export PYTHONPATH=%i/lib/python%type_raw[python]/site-packages
        cd $PYTHONPATH
        # For comparison, runtest.py has 17404 passed, 730 skipped, 1293 deselected, 28 xfailed, 8 xpassed, 1 warning
        # pytest should have 18460-18537 passed, 968-889 skipped, 1 deselected, 27-28 xfailed, 8 xpassed, 230-246 warnings
        # >       ForkingPickler(file, protocol).dump(obj)
        # E       AttributeError: Can't pickle local object 'TestSaveTxt.test_large_zip.<locals>.check_large_zip'
        # %p/lib/python3.10/multiprocessing/reduction.py:60: AttributeError
        # various combinations of data/dtype/ufunc failing in `test_unary_spurious_fpexception` on x86_64
        # some tests (f2py in particular) spawn external compilation processes requiring meson and/or broken on Python 3.11+
        SKIP='test_mem_policy or test_cython'
        if [ %m == x86_64 ]; then
            SKIP="$SKIP or spurious_fpexception"
        fi
        # numpy.random (with pytest_cache?) can raise "ValueError: state must be for a PCG64 RNG" by the thousands
        SHELL=/bin/sh %p/bin/python%type_raw[python] -Bm pytest --cache-clear --cache-show
        if [ %type_pkg[python] -le 310 ]; then
            SHELL=/bin/sh %p/bin/python%type_raw[python] -Bm pytest numpy -k "not ($SKIP)" || echo "Test failures"
        else
            SKIP="$SKIP or test_randomstate"
            SHELL=/bin/sh %p/bin/python%type_raw[python] -Bm pytest numpy/[a-dl-t]*/ numpy/fft -k "not ($SKIP)" || echo "Test failures"
        fi
        rm -r numpy/.pytest_cache
    fi
 
    # We don't supply py-unversioned of this tool (could do it via update-alternatives
    # if there is demand). f2py3 no longer built on Python 3.10+.
    # rm %i/bin/f2py?(3)  # not supported by basic sh?
    rm -f %i/bin/f2py{,3}
<<
